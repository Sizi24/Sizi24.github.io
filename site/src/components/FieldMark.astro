---
// Ein Feld wie in der App (Regeln in src/lib/field.ts).
import { field } from '../lib/field';
interface Props { code: string; value?: boolean }
const { code, value = false } = Astro.props;
const { label, cls, v } = field(code);
---
<span class="dv"><span class={'fm ' + cls}>{label}</span>{value && v !== null && <span class="val">({v})</span>}</span>
