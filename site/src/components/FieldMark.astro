---
// Ein Feld wie in der App: Feldmarke in Boardfarbe, Wert grau in Klammern ("T20 (60)").
// Rot bei 20, 18, 13, 10, 2, 3, 7, 8, 14, 12; sonst grün. Singles in Board-Schwarz bzw. -Creme. Bull rot, 25 grün.
interface Props { code: string; value?: boolean }
const { code, value = false } = Astro.props;
const RED = new Set([20, 18, 13, 10, 2, 3, 7, 8, 14, 12]);
let label: string, cls: string, v: number | null;
if (code === 'BULL') { label = 'Bull'; cls = 'r'; v = 50; }
else {
  const ring = code[0], n = Number(code.slice(1));
  if (n === 25) { label = '25'; cls = 'g'; v = 25; }
  else if (ring === 'S') { label = String(n); cls = RED.has(n) ? 'd' : 'l'; v = null; }
  else { label = ring + n; cls = RED.has(n) ? 'r' : 'g'; v = n * (ring === 'T' ? 3 : 2); }
}
---
<span class="dv"><span class={'fm ' + cls}>{label}</span>{value && v !== null && <span class="val">({v})</span>}</span>
