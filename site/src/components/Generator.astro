---
// Checkout-Liste zum Ausdrucken: Lieblings-Doppel und Bereich wählen, jeden Weg antippen und austauschen.
// Wege mit Lieblings-Doppel genau wie in der App (CheckoutTable.swift favouriteRaw, Änderung 333/336).
// Eigene Wege wie „Mein Weg“ in der App (OwnRouteEditor, CheckoutEngine.ownRouteProblem, OwnRouteRest):
// gleiche Tasten (Triple zuerst, Auswahl bleibt stehen), gleiche Prüfung, gleiche Sätze.
import Base from '../layouts/Base.astro';
import FieldMark from './FieldMark.astro';
import PrintHead from './PrintHead.astro';
import { t, PAIRS, type Lang } from '../i18n';
import { SITE } from '../config';
interface Props { lang: Lang }
const { lang } = Astro.props;
const L = (de: string, en: string) => t(lang, de, en);
const home = lang === 'de' ? '/' : '/en/';
const self = lang === 'de' ? PAIRS.list.de : PAIRS.list.en;
const table = lang === 'de' ? PAIRS.table.de : PAIRS.table.en;
const DOUBLES = [20, 16, 18, 10, 12, 8];
const RANGES = [[2, 170], [2, 40], [41, 100], [101, 170]];
const title = L('Checkout-Liste erstellen: deine eigenen Checkout-Wege', 'Make your own darts checkout list with your checkout routes');
const jsonld = [{
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Dardo', item: SITE + home },
    { '@type': 'ListItem', position: 2, name: L('Checkout-Liste', 'Checkout list'), item: SITE + self },
  ],
}];
// Texte für das Skript im Browser.
const TXT = {
  fav: L('Dein Doppel', 'Your double'),
  mine: L('Mein Weg', 'My route'),
  subPro: L('Profi-Wege', 'Pro routes'),
  subFav: L('Lieblings-Doppel D#', 'Favourite double D#'),
  to: L('bis', 'to'),
  count: L('# Finishes', '# finishes'),
  countFav: L('$ auf dein Doppel umgestellt', '$ moved onto your double'),
  own1: L('1 eigener Weg', '1 own route'),
  ownN: L('# eigene Wege', '# own routes'),
  bogeys: L('Kein Finish mit drei Darts (Bogeys):', 'No three-dart finish (bogeys):'),
  copied: L('Link kopiert', 'Link copied'),
  legendFav: L('Goldene Zahl: Weg auf dein Lieblings-Doppel.', 'Gold number: route onto your favourite double.'),
  legendMine: L('Goldene Zahl: dein eigener Weg.', 'Gold number: your own route.'),
  legendBoth: L('Goldene Zahl: dein eigener Weg oder dein Lieblings-Doppel.', 'Gold number: your own route or your favourite double.'),
  edit: L('Weg ändern', 'Change route'),
  dlgTitle: L('Weg für', 'Route for'),
  pro: L('Profi-Weg', 'Pro route'),
  rule: L('Letzter Dart: Doppel oder Bull.', 'Last dart: a double or the bull.'),
  tapDart: L('Tippe einen Dart an, um ihn zu ändern.', 'Tap a dart to change it.'),
  ringT: L('Triple', 'Treble'), ringD: L('Doppel', 'Double'), ringS: 'Single',
  remove: L('antippen zum Entfernen', 'tap to remove'),
  left: L('Rest', 'Left'),
  over: L('Nach diesem Dart ist die Aufnahme vorbei.', 'The visit is over after this dart.'),
  bust: L('Überworfen.', 'Bust.'),
  rest: L('Geht nicht auf: Es bleiben #.', 'Doesn’t check out: # left.'),
  lastDouble: L('Der letzte Dart muss ein Doppel oder das Bull sein.', 'The last dart has to be a double or the bull.'),
  samePro: L('Das ist schon der Profi-Weg.', 'That’s already the pro route.'),
  sameFav: L('Das ist schon der Weg auf dein Doppel.', 'That’s already the route onto your double.'),
  askAll: L('Alle # eigenen Wege löschen?', 'Delete all # own routes?'),
  askOne: L('Deinen eigenen Weg löschen?', 'Delete your own route?'),
};
---
<Base lang={lang} page="list" jsonld={jsonld} title={title}
  description={L('Deine eigene Checkout-Liste zum Ausdrucken: Lieblings-Doppel wählen, Checkout-Wege austauschen, als A4-PDF drucken und am Board üben.', 'Your own checkout list to print: pick your favourite double, swap any checkout route, print it on one A4 page and practise at the board.')}>
  <div class="gut"><div class="inner" style="padding-block:18px 30px" id="gen" data-lang={lang}>
    <script type="application/json" id="gen-txt" set:html={JSON.stringify(TXT)} />
    <nav class="crumb" aria-label={L('Brotkrumen', 'Breadcrumb')}><a href={home}>Dardo</a> › {L('Checkout-Liste', 'Checkout list')}</nav>
    <PrintHead lang={lang} title={L('Meine Checkout-Liste', 'My checkout list')} sub={L('Profi-Wege', 'Pro routes')} />
    <div class="page-head">
      <h1>{L('Deine eigene Checkout-Liste', 'Your own checkout list')}</h1>
      <p>{L('Wähle dein Lieblings-Doppel und den Bereich. Jeden Checkout-Weg kannst du antippen und austauschen. Dann drucken.', 'Pick your favourite double and a range. Tap any checkout route to swap it. Then print.')}</p>
    </div>
    <form class="card gen-form" id="form" onsubmit="return false">
      <fieldset>
        <legend>{L('Lieblings-Doppel', 'Favourite double')}</legend>
        <div class="seg">
          <label><input type="radio" name="d" value="0" checked><span>{L('Keins', 'None')}</span></label>
          {DOUBLES.map((d) => <label class="dbl"><input type="radio" name="d" value={d}><span><FieldMark code={'D' + d} /></span></label>)}
        </div>
        <p class="hint">{L('Zählt nur bei gleich vielen Darts, wo es kaum etwas kostet. Genau wie in der App.', 'Only with the same number of darts, where it costs almost nothing. Just like in the app.')}</p>
      </fieldset>
      <fieldset>
        <legend>{L('Bereich', 'Range')}</legend>
        <div class="seg">
          {RANGES.map(([a, b], i) => <label><input type="radio" name="r" value={a + '-' + b} checked={i === 0}><span>{i === 0 ? L('Alle', 'All') : a + '–' + b}</span></label>)}
          <label><input type="radio" name="r" value="eigen"><span>{L('Eigener', 'Custom')}</span></label>
        </div>
        <div class="own" id="own" hidden>
          <label>{L('von', 'from')} <input type="number" id="von" min="2" max="170" value="2" inputmode="numeric"></label>
          <label>{L('bis', 'to')} <input type="number" id="bis" min="2" max="170" value="170" inputmode="numeric"></label>
        </div>
      </fieldset>
      <label class="check"><input type="checkbox" id="werte" checked> {L('Werte zeigen, z. B. T20 (60)', 'Show values, e.g. T20 (60)')}</label>
    </form>
    <div class="tools gen-tools">
      <p class="count" id="count" role="status" aria-live="polite"></p>
      <button class="btn" type="button" id="drucken">{L('Als PDF drucken', 'Print as PDF')}</button>
      <button class="btn ghost" type="button" id="teilen">{L('Link kopieren', 'Copy link')}</button>
      <button class="btn ghost" type="button" id="alle-weg" hidden>{L('Eigene Wege löschen', 'Delete own routes')}</button>
    </div>
    <p class="legend noprint">{L('Tippe ein Finish an, um deinen eigenen Weg zu wählen.', 'Tap a finish to choose your own route.')}</p>
    <ul class="rows" id="rows"></ul>
    <div class="card bogey" id="bogey" hidden></div>
    <p class="print-foot print-only">{L('Erstellt auf dardoapp.com. Die App Dardo übt jeden Rest mit dir.', 'Made at dardoapp.com. The Dardo app practises every score with you.')}</p>
    <noscript><p class="note">{L('Ohne JavaScript geht der Generator nicht. Die ganze Tabelle findest du hier:', 'The generator needs JavaScript. The full chart is here:')} <a href={table}>{L('Checkout-Tabelle', 'Checkout chart')}</a></p></noscript>
    <p class="note noprint">{L('Alle Wege mit Erklärung:', 'All routes explained:')} <a href={table}>{L('Checkout-Tabelle 2 bis 170', 'Checkout chart 2 to 170')}</a></p>
  </div></div>

  <!-- Fenster „Weg für …“: gängige Wege mit einem Tipp, darunter selbst eintippen wie „Mein Weg“ in der App. -->
  <dialog class="wd" id="wd" aria-labelledby="wd-title">
    <div class="wd-head">
      <h2 id="wd-title">{L('Weg für', 'Route for')} <b id="wd-n"></b></h2>
      <button class="wd-x" type="button" id="wd-x" aria-label={L('Schließen', 'Close')}><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M3.5 3.5l9 9M12.5 3.5l-9 9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></button>
    </div>
    <div class="wd-tabs" role="group" aria-label={L('Weg wählen', 'Choose route')}>
      <button type="button" data-tab="picks" aria-pressed="true">{L('Gängige Wege', 'Common routes')}</button>
      <button type="button" data-tab="pad" aria-pressed="false">{L('Selbst eintippen', 'Type your own')}</button>
    </div>
    <div class="picks" id="wd-picks"></div>
    <div id="wd-own" hidden>
    <p class="wd-msg" id="wd-msg" aria-live="polite"></p>
    <div class="slots" id="wd-slots"></div>
    <button class="btn wd-save" type="button" id="wd-save" hidden>{L('Speichern', 'Save')}</button>
    <div class="pad" id="wd-pad">
      <div class="rings" role="group" aria-label={L('Ring', 'Ring')}>
        <button type="button" data-ring="T">{L('Triple', 'Treble')}</button>
        <button type="button" data-ring="D">{L('Doppel', 'Double')}</button>
        <button type="button" data-ring="S">Single</button>
      </div>
      <div class="keys" id="wd-keys"></div>
      <div class="keys bulls" id="wd-bulls"></div>
    </div>
    </div>
    <button class="btn ghost wd-del" type="button" id="wd-del" hidden>{L('Eigenen Weg löschen', 'Delete own route')}</button>
  </dialog>
  <!-- Rückfrage vor dem Löschen, als eigenes Fenster wie in der App. -->
  <dialog class="wd ask" id="ask" aria-labelledby="ask-q">
    <p id="ask-q"></p>
    <div class="ask-btns">
      <button class="btn ghost" type="button" id="ask-no">{L('Abbrechen', 'Cancel')}</button>
      <button class="btn danger" type="button" id="ask-yes">{L('Löschen', 'Delete')}</button>
    </div>
  </dialog>

  <script>
    import data from '../data/checkouts.json';
    import { field } from '../lib/field';
    const root = document.getElementById('gen')!;
    const T = JSON.parse(document.getElementById('gen-txt')!.textContent || '{}') as Record<string, string>;
    const first = data.first as Record<string, string[]>;
    const alts = data.alts as Record<string, string[][]>;
    const favourite = data.favourite as Record<string, Record<string, string[]>>;
    const GROUPS = [170, 130, 100, 80, 60, 40, 20];
    const form = document.getElementById('form') as HTMLFormElement;
    const own = document.getElementById('own')!;
    const von = document.getElementById('von') as HTMLInputElement;
    const bis = document.getElementById('bis') as HTMLInputElement;
    const werte = document.getElementById('werte') as HTMLInputElement;
    const list = document.getElementById('rows')!;
    const bogey = document.getElementById('bogey')!;
    const count = document.getElementById('count')!;
    const allDel = document.getElementById('alle-weg') as HTMLButtonElement;
    const sub = document.getElementById('ph-sub');
    const legend = document.querySelector('.ph-legend');
    const baseLegend = legend?.textContent || '';
    void root;

    // ---- Darts: Kurzschreibweise wie in der App ("T20", "D16", "S5", "25", "BULL") ----
    const CODE = /^(?:([SDT])([1-9]|1\d|20)|25|BULL)$/;
    const value = (c: string) => c === 'BULL' ? 50 : c === '25' ? 25 : Number(c.slice(1)) * ({ S: 1, D: 2, T: 3 } as Record<string, number>)[c[0]];
    const isDouble = (c: string) => c === 'BULL' || c[0] === 'D';
    const label = (c: string) => field(c).label;
    // Wie CheckoutEngine.signature: Reihenfolge der Darts vor dem letzten egal.
    const sig = (r: string[]) => r.length ? r.slice(0, -1).map(label).sort().join(',') + '|' + label(r[r.length - 1]) : '';
    const sum = (r: string[]) => r.reduce((a, c) => a + value(c), 0);

    // Prüfung wie CheckoutEngine.ownRouteProblem (ohne den Vergleich mit dem Weg in der Liste).
    function problem(r: string[], n: number): string | null {
      if (!r.length) return T.rule;
      if (r.length > 3) return T.over;
      let rest = n;
      for (let i = 0; i < r.length; i++) { rest -= value(r[i]); if (rest <= 1 && i < r.length - 1) return T.over; }
      if (sum(r) !== n) { const left = n - sum(r); return left < 2 ? T.bust : T.rest.replace('#', String(left)); }
      if (!isDouble(r[r.length - 1])) return T.lastDouble;
      return null;
    }

    // ---- Eigene Wege: Rest -> Darts. In der Adresse (zum Teilen) und auf diesem Gerät. ----
    const KEY = 'dardo-eigene-wege';
    let mine: Record<string, string[]> = {};
    const valid = (n: number, r: string[]) => !!first[n] && r.length > 0 && r.every((c) => CODE.test(c)) && problem(r, n) === null;
    function parseWege(s: string) {
      const out: Record<string, string[]> = {};
      for (const part of s.split(',')) {
        const [k, v] = part.split(':');
        const n = Number(k), r = (v || '').toUpperCase().split('.').filter(Boolean);
        if (valid(n, r)) out[n] = r;
      }
      return out;
    }
    const wegeText = () => Object.keys(mine).map(Number).sort((a, b) => b - a).map((n) => n + ':' + mine[n].join('.')).join(',');
    function keep() { try { localStorage.setItem(KEY, wegeText()); } catch { /* ohne Speicher bleibt es in der Adresse */ } }

    // ---- Liste ----
    const el = (tag: string, cls?: string, text?: string) => { const n = document.createElement(tag); if (cls) n.className = cls; if (text) n.textContent = text; return n; };
    function route(codes: string[], showValue: boolean) {
      const rt = el('span', 'rt');
      codes.forEach((c, i) => {
        if (i > 0) { const d = el('span', 'dot', '·'); d.setAttribute('aria-hidden', 'true'); rt.append(d); }
        const f = field(c), dv = el('span', 'dv');
        dv.append(el('span', 'fm ' + f.cls, f.label));
        if (showValue && f.v !== null) dv.append(el('span', 'val', '(' + f.v + ')'));
        rt.append(dv);
      });
      return rt;
    }
    const PEN = '<svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><path d="M10.6 2.6l2.8 2.8-7.7 7.7-3.3.5.5-3.3z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>';
    const clamp = (n: number) => Math.min(170, Math.max(2, Math.round(n) || 2));

    function read() {
      const fd = new FormData(form);
      const d = Number(fd.get('d')) || 0;
      const r = String(fd.get('r'));
      let a = 2, b = 170;
      if (r === 'eigen') { a = clamp(Number(von.value)); b = clamp(Number(bis.value)); if (a > b) [a, b] = [b, a]; }
      else [a, b] = r.split('-').map(Number);
      return { d, r, a, b, w: werte.checked };
    }
    // Weg in der Liste ohne eigenen Weg: Lieblings-Doppel, sonst Profi-Weg.
    const favRoute = (n: number, d: number) => (d ? favourite[String(d)]?.[String(n)] : undefined);
    const base = (n: number, d: number) => favRoute(n, d) || first[n];
    // Eigener Weg gilt nur, wo er vom Weg in der Liste abweicht (z. B. Profi-Weg statt Doppel-Weg bleibt gespeichert).
    const ownRoute = (n: number, d: number) => (mine[n] && sig(mine[n]) !== sig(base(n, d)) ? mine[n] : undefined);

    function render() {
      const s = read();
      own.hidden = s.r !== 'eigen';
      list.textContent = '';
      let n = 0, moved = 0, ownCount = 0, group = -1;
      for (let r = s.b; r >= s.a; r--) {
        if (!first[r]) continue;
        const g = GROUPS.findIndex((top, k) => r <= top && r > (GROUPS[k + 1] ?? 1));
        if (g !== group) {
          group = g;
          const top = Math.min(GROUPS[g], s.b), low = Math.max((GROUPS[g + 1] ?? 1) + 1, s.a);
          const h = el('li', 'grp', top + ' ' + T.to + ' ' + low); h.setAttribute('aria-hidden', 'true'); list.append(h);
        }
        const fav = favRoute(r, s.d), my = ownRoute(r, s.d);
        const li = el('li');
        const b = el('button', 'row' + (my ? ' mine' : fav ? ' fav' : '')) as HTMLButtonElement;
        b.type = 'button'; b.dataset.n = String(r);
        const shown = my || fav || first[r];
        b.setAttribute('aria-label', r + ': ' + shown.map(label).join(', ') + '. ' + (my ? T.mine + '. ' : fav ? T.fav + '. ' : '') + T.edit);
        b.append(el('span', 'n', String(r)), route(shown, s.w));
        if (my) { b.append(el('span', 'tag', T.mine)); ownCount++; }
        else if (fav) { b.append(el('span', 'tag', T.fav)); moved++; }
        const pen = el('span', 'ed'); pen.innerHTML = PEN; b.append(pen, el('span', 'sr', T.edit));
        li.append(b); list.append(li); n++;
      }
      // Druck: Zeilen je Spalte für das Drei-Spalten-Grid (siehe site.css @media print).
      list.style.setProperty('--prow', String(Math.ceil(list.children.length / 3)));
      // Alle eigenen Wege zählen, auch außerhalb des Bereichs, damit „Eigene Wege löschen“ zur Zahl passt.
      const total = Object.keys(mine).filter((k) => ownRoute(Number(k), s.d)).length;
      const parts = [T.count.replace('#', String(n))];
      if (s.d) parts.push(T.countFav.replace('$', String(moved)));
      if (total) parts.push(total === 1 ? T.own1 : T.ownN.replace('#', String(total)));
      count.textContent = parts.join(' · ');
      allDel.hidden = !total;
      const bg = data.bogeys.filter((x) => x >= s.a && x <= s.b);
      bogey.hidden = !bg.length;
      bogey.textContent = '';
      if (bg.length) { bogey.append(el('b', '', T.bogeys), ' ' + bg.join(', ') + '.'); }
      const range = s.a === 2 && s.b === 170 ? '2 ' + T.to + ' 170' : s.b + ' ' + T.to + ' ' + s.a;
      const head = [s.d ? T.subFav.replace('#', String(s.d)) : T.subPro];
      if (ownCount) head.push(ownCount === 1 ? T.own1 : T.ownN.replace('#', String(ownCount)));
      if (sub) sub.textContent = head.join(' · ') + ' · ' + range;
      if (legend) legend.textContent = baseLegend + (ownCount && moved ? ' ' + T.legendBoth : ownCount ? ' ' + T.legendMine : moved ? ' ' + T.legendFav : '');
      // Einstellungen und eigene Wege in der Adresse, damit man die Liste teilen kann.
      const p = new URLSearchParams();
      if (s.d) p.set('doppel', String(s.d));
      if (s.a !== 2 || s.b !== 170) { p.set('von', String(s.a)); p.set('bis', String(s.b)); }
      if (!s.w) p.set('werte', '0');
      if (Object.keys(mine).length) p.set('wege', wegeText());
      history.replaceState(null, '', location.pathname + (p.toString() ? '?' + p.toString().replace(/%3A/g, ':').replace(/%2C/g, ',') : ''));
    }

    // ---- Fenster „Weg für …“ ----
    const wd = document.getElementById('wd') as HTMLDialogElement;
    const wdN = document.getElementById('wd-n')!;
    const picks = document.getElementById('wd-picks')!;
    const msg = document.getElementById('wd-msg')!;
    const slots = document.getElementById('wd-slots')!;
    const save = document.getElementById('wd-save') as HTMLButtonElement;
    const del = document.getElementById('wd-del') as HTMLButtonElement;
    const keys = document.getElementById('wd-keys')!;
    const bulls = document.getElementById('wd-bulls')!;
    const ringBtns = [...wd.querySelectorAll<HTMLButtonElement>('[data-ring]')];
    let cur = 0, ring = 'T', darts: string[] = [], verdict: 'open' | 'good' | 'bad' = 'open', why = '';

    function key(code: string, text: string, name = text) {
      const b = el('button', 'key') as HTMLButtonElement; b.type = 'button'; b.setAttribute('aria-label', name);
      const f = field(code); b.append(el('span', 'fm ' + f.cls, text));
      b.addEventListener('click', () => add(code));
      return b;
    }
    function drawKeys() {
      keys.textContent = '';
      const ringName = ({ T: T.ringT, D: T.ringD, S: T.ringS } as Record<string, string>)[ring];
      for (let i = 1; i <= 20; i++) keys.append(key(ring + i, String(i), ringName + ' ' + i));
      ringBtns.forEach((b) => { const on = b.dataset.ring === ring; b.classList.toggle('on', on); b.setAttribute('aria-pressed', String(on)); });
    }
    bulls.append(key('25', '25'), key('BULL', 'Bull'));
    ringBtns.forEach((b) => b.addEventListener('click', () => { ring = b.dataset.ring!; drawKeys(); }));

    // Rest unter jedem Dart wie OwnRouteRest.marks: rot bei überworfen, grün nur am letzten Dart nach gültiger Prüfung.
    function drawSlots() {
      slots.textContent = '';
      let rest = cur;
      for (let i = 0; i < 3; i++) {
        const box = el('div', 'slot');
        if (i < darts.length) {
          const c = darts[i];
          rest -= value(c);
          const last = i === darts.length - 1, checked = rest === 0 && isDouble(c);
          const tone = checked && last && verdict === 'good' ? 'good' : ((rest < 2 && !checked) || (last && verdict === 'bad')) ? 'bad' : '';
          const b = el('button', 'dart') as HTMLButtonElement; b.type = 'button';
          const f = field(c); b.append(el('span', 'fm ' + f.cls, f.label));
          b.setAttribute('aria-label', f.label + ', ' + T.remove);
          b.addEventListener('click', () => { darts = darts.slice(0, i); verdict = 'open'; why = ''; update(); });
          const r = el('span', 'left ' + tone);
          r.append(el('small', '', T.left), el('b', '', (tone === 'good' ? '✓ ' : tone === 'bad' ? '✕ ' : '') + rest));
          box.append(b, r);
        } else {
          box.append(el('span', 'empty-dart'), el('span', 'left'));
        }
        slots.append(box);
      }
    }
    function update() {
      msg.className = 'wd-msg' + (verdict === 'bad' ? ' bad' : '');
      msg.textContent = verdict === 'bad' ? why + ' ' + T.tapDart : T.rule;
      save.hidden = verdict !== 'good';
      drawSlots();
    }
    function add(code: string) {
      if (verdict !== 'open' || darts.length >= 3) return;
      darts.push(code);
      const total = sum(darts);
      if ((total === cur && isDouble(code)) || darts.length === 3 || total >= cur - 1) check();
      update();
    }
    function check() {
      const d = read().d;
      const p = problem(darts, cur);
      if (p) { verdict = 'bad'; why = p; return; }
      if (sig(darts) === sig(base(cur, d))) { verdict = 'bad'; why = favRoute(cur, d) ? T.sameFav : T.samePro; return; }
      verdict = 'good';
    }
    function choose(r: string[] | null) {
      const d = read().d;
      if (!r || sig(r) === sig(base(cur, d))) delete mine[cur]; else mine[cur] = r.slice();
      keep(); render(); wd.close();
    }
    function drawPicks() {
      const d = read().d, now = ownRoute(cur, d) || base(cur, d);
      const seen = new Set<string>(), opts: { r: string[]; tag: string }[] = [];
      const push = (r: string[] | undefined, tag = '') => { if (r && !seen.has(sig(r))) { seen.add(sig(r)); opts.push({ r, tag }); } };
      push(first[cur], T.pro);
      push(favRoute(cur, d), T.fav);
      (alts[cur] || []).forEach((r) => push(r));
      DOUBLES.forEach((x) => push(favourite[String(x)]?.[String(cur)]));
      if (ownRoute(cur, d)) push(mine[cur], T.mine);
      picks.textContent = '';
      for (const o of opts) {
        const b = el('button', 'pick' + (sig(o.r) === sig(now) ? ' on' : '')) as HTMLButtonElement; b.type = 'button';
        b.setAttribute('aria-pressed', String(sig(o.r) === sig(now)));
        b.append(route(o.r, werte.checked));
        if (o.tag) b.append(el('span', 'tag', o.tag));
        b.addEventListener('click', () => choose(o.r));
        picks.append(b);
      }
    }
    const DOUBLES = [20, 16, 18, 10, 12, 8];
    const tabs = [...wd.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const ownBox = document.getElementById('wd-own')!;
    function tab(name: string) {
      tabs.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.tab === name)));
      picks.hidden = name !== 'picks'; ownBox.hidden = name !== 'pad';
    }
    tabs.forEach((b) => b.addEventListener('click', () => tab(b.dataset.tab!)));
    function open(n: number) {
      cur = n; ring = 'T'; darts = []; verdict = 'open'; why = '';
      wdN.textContent = String(n);
      del.hidden = !ownRoute(n, read().d);
      drawPicks(); drawKeys(); update(); tab('picks');
      wd.showModal();
    }
    list.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button.row');
      if (b) open(Number(b.dataset.n));
    });
    save.addEventListener('click', () => choose(darts));
    document.getElementById('wd-x')!.addEventListener('click', () => wd.close());
    const outside = (d: HTMLDialogElement, e: MouseEvent) => {
      if (e.target !== d) return false;
      const r = d.getBoundingClientRect();
      return e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom;
    };
    wd.addEventListener('click', (e) => { if (outside(wd, e)) wd.close(); });
    wd.addEventListener('close', () => { list.querySelector<HTMLButtonElement>(`button.row[data-n="${cur}"]`)?.focus(); });

    // ---- Rückfrage vor dem Löschen ----
    const ask = document.getElementById('ask') as HTMLDialogElement;
    let onYes = () => {};
    function confirmDelete(q: string, yes: () => void) { document.getElementById('ask-q')!.textContent = q; onYes = yes; ask.showModal(); }
    document.getElementById('ask-no')!.addEventListener('click', () => ask.close());
    let back: () => HTMLElement | null = () => null;
    document.getElementById('ask-yes')!.addEventListener('click', () => { ask.close(); onYes(); (back() || document.getElementById('drucken'))?.focus(); });
    ask.addEventListener('click', (e) => { if (outside(ask, e)) ask.close(); });
    del.addEventListener('click', () => {
      wd.close();
      back = () => list.querySelector<HTMLButtonElement>(`button.row[data-n="${cur}"]`);
      confirmDelete(T.askOne, () => { delete mine[cur]; keep(); render(); });
    });
    allDel.addEventListener('click', () => {
      const k = Object.keys(mine).filter((x) => ownRoute(Number(x), read().d)).length;
      back = () => null;
      confirmDelete(k === 1 ? T.askOne : T.askAll.replace('#', String(k)), () => { mine = {}; keep(); render(); });
    });

    // ---- Einstellungen aus der Adresse übernehmen ----
    const q = new URLSearchParams(location.search);
    const qd = q.get('doppel');
    if (qd) { const input = form.querySelector<HTMLInputElement>(`input[name=d][value="${CSS.escape(qd)}"]`); if (input) input.checked = true; }
    if (q.has('von') || q.has('bis')) {
      const a = clamp(Number(q.get('von') || 2)), b = clamp(Number(q.get('bis') || 170));
      const preset = form.querySelector<HTMLInputElement>(`input[name=r][value="${a}-${b}"]`);
      if (preset) preset.checked = true;
      else { form.querySelector<HTMLInputElement>('input[name=r][value=eigen]')!.checked = true; von.value = String(a); bis.value = String(b); }
    }
    if (q.get('werte') === '0') werte.checked = false;
    // Geteilter Link gewinnt, sonst die Wege von diesem Gerät.
    let stored = '';
    try { stored = localStorage.getItem(KEY) || ''; } catch { /* kein Speicher */ }
    mine = parseWege(q.get('wege') ?? stored);

    form.addEventListener('input', render);
    form.addEventListener('change', render);
    render();
    document.getElementById('drucken')!.addEventListener('click', () => window.print());
    const teilen = document.getElementById('teilen')!;
    const teilenText = teilen.textContent;
    teilen.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(location.href); teilen.textContent = T.copied; setTimeout(() => (teilen.textContent = teilenText), 1600); } catch { /* Kopieren nicht erlaubt: Adresse steht oben im Browser. */ }
    });
  </script>
</Base>
