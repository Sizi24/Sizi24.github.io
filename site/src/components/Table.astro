---
import Base from '../layouts/Base.astro';
import Route from './Route.astro';
import { t, type Lang } from '../i18n';
import { SITE } from '../config';
import data from '../data/checkouts.json';
interface Props { lang: Lang }
const { lang } = Astro.props;
const L = (de: string, en: string) => t(lang, de, en);
const first = data.first as Record<string, string[]>;
const rows = Object.keys(first).map(Number).sort((a, b) => b - a);
const home = lang === 'de' ? '/' : '/en/';
const self = lang === 'de' ? '/checkout-tabelle/' : '/en/checkout-chart/';
const title = L('Checkout-Tabelle Darts: alle Finishes von 2 bis 170', 'Darts checkout chart: every finish from 2 to 170');
const darts = (n: number) => L(n === 1 ? '1 Dart' : n + ' Darts', n === 1 ? '1 dart' : n + ' darts');
const jsonld = [{
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Dardo', item: SITE + home },
    { '@type': 'ListItem', position: 2, name: L('Checkout-Tabelle', 'Checkout chart'), item: SITE + self },
  ],
}];
---
<Base lang={lang} page="table" jsonld={jsonld} title={title}
  description={L('Die komplette Darts-Checkout-Tabelle: der Profi-Weg für jeden Rest von 2 bis 170 mit Double Out, dazu alle Bogey-Zahlen. Zum Nachschlagen und Ausdrucken.', 'The complete darts checkout chart: the pro route for every score from 2 to 170 with double out, plus all bogey numbers. Look it up or print it.')}>
  <div class="gut"><div class="inner" style="padding-block:18px 30px">
    <nav class="crumb" aria-label={L('Brotkrumen', 'Breadcrumb')}><a href={home}>Dardo</a> › {L('Checkout-Tabelle', 'Checkout chart')}</nav>
    <div class="page-head">
      <h1>{L('Checkout-Tabelle: alle Finishes von 2 bis 170', 'Darts checkout chart: every finish from 2 to 170')}</h1>
      <p>{L('So spielen Profis jeden Rest mit Double Out. Der letzte Dart muss ein Doppel oder das Bull treffen.', 'How pros play every score with double out. The last dart has to hit a double or the bull.')}</p>
      <p class="print-only">{L('Dardo Checkout-Tabelle · dardoapp.com', 'Dardo checkout chart · dardoapp.com')}</p>
    </div>
    <div class="tools">
      <label class="search" for="q"><span aria-hidden="true" style="color:var(--t60)">⌕</span>
        <input id="q" type="search" inputmode="numeric" autocomplete="off" placeholder={L('Rest suchen, z. B. 121', 'Find a score, e.g. 121')} aria-label={L('Rest suchen', 'Find a score')}></label>
      <button class="btn ghost" type="button" id="drucken">{L('Als PDF drucken', 'Print as PDF')}</button>
    </div>
    <p class="empty" id="leer" role="status" aria-live="polite" hidden data-bogeys={data.bogeys.join(',')}
      data-none={L('Kein Finish gefunden. Gesucht wird von 2 bis 170.', 'No finish found. Scores go from 2 to 170.')}
      data-bogey={L('# ist ein Bogey: dafür gibt es kein Finish mit drei Darts.', '# is a bogey: there is no three-dart finish for it.')}></p>
    <ul class="rows" id="rows">
      {rows.map((r) => (
        <li class="row" data-n={r}>
          <span class="n">{r}</span>
          <span class="rt"><Route codes={first[r]} /></span>
          <span class="k">{darts(first[r].length)}</span>
        </li>
      ))}
    </ul>
    <div class="card bogey"><b>{L('Kein Finish mit drei Darts (Bogeys):', 'No three-dart finish (bogeys):')}</b> <span style="color:var(--t72)">{data.bogeys.join(', ')}.</span></div>
    <p class="note noprint">{L('Felder: T = Triple, D = Doppel, Zahl allein = Single, Bull = 50, 25 = Single Bull. Die Wege sind dieselben wie in der App Dardo.', 'Fields: T = treble, D = double, number alone = single, Bull = 50, 25 = outer bull. The routes are the same as in the Dardo app.')}</p>
  </div></div>
  <script>
    // Suche: zeigt nur Reste, die mit der eingetippten Zahl beginnen. Drucken: Druckvorlage des Browsers.
    const q = document.getElementById('q') as HTMLInputElement;
    const rows = Array.from(document.querySelectorAll<HTMLElement>('#rows .row'));
    const leer = document.getElementById('leer')!;
    q.addEventListener('input', () => {
      const v = q.value.replace(/\D/g, '');
      let shown = 0;
      for (const r of rows) { const ok = !v || (r.dataset.n || '').startsWith(v); r.hidden = !ok; if (ok) shown++; }
      const bogey = (leer.dataset.bogeys || '').split(',').includes(v);
      leer.textContent = (bogey ? leer.dataset.bogey! : leer.dataset.none!).replace('#', v);
      leer.hidden = shown > 0;
    });
    document.getElementById('drucken')!.addEventListener('click', () => window.print());
  </script>
</Base>
