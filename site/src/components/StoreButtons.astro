---
// Store-Knöpfe. Oben der Knopf zur Checkout-Tabelle (vor dem Start Messing, danach umrandet),
// darunter die große Kachel „Checkout-Wege lernen“ mit App Store und Google Play (Salva 10.11.).
// Am Starttag IOS_LIVE/ANDROID_LIVE.
import { IOS_LIVE, ANDROID_LIVE, APP_STORE, GOOGLE_PLAY } from '../config';
import { t, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const live = IOS_LIVE || ANDROID_LIVE;
// Offizielle Abzeichen (Apple Marketing Tools, Google Play Badges), unverändert; Google ohne durchsichtigen Rand.
// Breite bei 40 px Höhe. Regeln: App Store zuerst, gleiche Höhe, Freiraum ein Viertel der Höhe, mindestens 40 px.
const APPLE_W = { de: 120, en: 120 } as const;
const GP_W = { de: 135, en: 134 } as const;
const table = lang === 'de' ? '/checkout-tabelle/' : '/en/checkout-chart/';
---
<div class="stores">
  <a class={'cta' + (live ? ' ghost' : '')} href={table}>
    <span class="cta-ico" aria-hidden="true"><svg viewBox="0 0 16 16" set:html={'<rect x="1.8" y="2.5" width="12.4" height="11" rx="1.6" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M1.8 6.2h12.4M1.8 9.8h12.4M6 2.5v11" stroke="currentColor" stroke-width="1.3"/>'} /></span>
    <span class="cta-t"><b>{t(lang, 'Checkout‑Tabelle 2 bis 170', 'Checkout chart 2 to 170')}</b><small>{t(lang, 'Gratis nachschlagen oder eigene Liste drucken', 'Look it up free or print your own list')}</small></span>
    <span class="cta-arr" aria-hidden="true">›</span>
  </a>
  <div class="tile learn">
    <b>{t(lang, 'Checkout-Wege lernen statt nachschlagen', 'Learn checkout routes, don’t look them up')}</b>
    <span>{t(lang, 'Dardo übt jeden Rest mit dir, bis er sitzt.', 'Dardo practises every score with you until it sticks.')}</span>
    <div class="stores-in">
      {IOS_LIVE
        ? <a class="badge" href={APP_STORE} aria-label={t(lang, 'Dardo im App Store laden', 'Download Dardo on the App Store')}><img src={`/bilder/stores/app-store-${lang}.svg`} alt={t(lang, 'Laden im App Store', 'Download on the App Store')} width={APPLE_W[lang]} height="40" /></a>
        : <span class="store soon"><small>{t(lang, 'Bald im', 'Coming soon')}</small>App Store</span>}
      {ANDROID_LIVE
        ? <a class="badge" href={GOOGLE_PLAY} aria-label={t(lang, 'Dardo bei Google Play laden', 'Get Dardo on Google Play')}><img src={`/bilder/stores/google-play-${lang}.png`} alt={t(lang, 'Jetzt bei Google Play', 'Get it on Google Play')} width={GP_W[lang]} height="40" /></a>
        : <span class="store soon"><small>{t(lang, 'Bald bei', 'Coming soon')}</small>Google Play</span>}
    </div>
  </div>
</div>
