---
// Store-Knöpfe. Oben der Knopf zur Checkout-Tabelle (vor dem Start Messing, danach umrandet),
// darunter die große Kachel „Checkout-Wege lernen“ mit App Store und Google Play (Salva 10.11.).
// Am Starttag IOS_LIVE/ANDROID_LIVE.
import { IOS_LIVE, ANDROID_LIVE, APP_STORE, GOOGLE_PLAY } from '../config';
import { t, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const live = IOS_LIVE || ANDROID_LIVE;
const table = lang === 'de' ? '/checkout-tabelle/' : '/en/checkout-chart/';
---
<div class="stores">
  <a class={'store wide' + (live ? ' ghost' : '')} href={table}><small>{t(lang, 'Alle Finishes 2 bis 170 · eigene Liste erstellen', 'Every finish from 2 to 170 · make your own list')}</small>{t(lang, 'Zur Checkout-Tabelle', 'Open the checkout chart')}</a>
  <div class="tile learn">
    <b>{t(lang, 'Checkout-Wege lernen statt nachschlagen', 'Learn checkout routes, don’t look them up')}</b>
    <span>{t(lang, 'Dardo übt jeden Rest mit dir, bis er sitzt.', 'Dardo practises every score with you until it sticks.')}</span>
    <div class="stores-in">
      {IOS_LIVE
        ? <a class="store" href={APP_STORE}><small>{t(lang, 'Laden im', 'Download on the')}</small>App Store</a>
        : <span class="store soon"><small>{t(lang, 'Bald im', 'Coming soon to the')}</small>App Store</span>}
      {ANDROID_LIVE
        ? <a class="store" href={GOOGLE_PLAY}><small>{t(lang, 'Jetzt bei', 'Get it on')}</small>Google Play</a>
        : <span class="store soon"><small>{t(lang, 'Bald bei', 'Coming soon to')}</small>Google Play</span>}
    </div>
  </div>
</div>
